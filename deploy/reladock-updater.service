[Unit]
Description=RelaDock Agent binary updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=reladock
EnvironmentFile=/etc/reladock/agent.env
ExecStart=/opt/reladock/reladock-updater
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/etc/reladock /var/lib/reladock-agent /run/reladock-agent
ReadWritePaths=/opt/reladock /var/lib/reladock-updater /run/reladock-updater
ProtectHome=true
StateDirectory=reladock-updater
StateDirectoryMode=0700
RuntimeDirectory=reladock-updater
RuntimeDirectoryMode=0750
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
