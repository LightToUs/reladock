# Copy to /etc/reladock/control.env, chmod 0600. Fill values before starting.
APP_ENV=production
PUBLIC_ORIGIN=https://console.example.com:8443
LISTEN_ADDRESS=0.0.0.0:8443
DATABASE_URL=postgres://reladock:REPLACE_PASSWORD@127.0.0.1:5432/reladock?sslmode=disable
# Emergency development/test-only switch. Exact value true bypasses plan,
# quota and expiry gates while preserving manual pause/delete and real metering.
# Keep false or unset in commercial production.
# RELADOCK_DEVELOPMENT_ALLOW_UNENTITLED_RULES=false
TLS_CERT_FILE=/etc/reladock/tls/fullchain.pem
TLS_KEY_FILE=/etc/reladock/tls/privkey.pem
# Agent listener trust bundle and server identity. This directory must not
# contain the node-issuing CA private key.
AGENT_TLS_DIR=/etc/reladock/agent-server-pki
AGENT_LISTEN_ADDRESS=0.0.0.0:9443
# Optional Stripe connector. All four must be configured together; default disabled.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SUCCESS_URL=https://console.example.com:8443/
# STRIPE_CANCEL_URL=https://console.example.com:8443/
# Optional incident webhook. Both required together; default sends nothing.
# NOTIFICATION_WEBHOOK_URL=https://alerts.example.com/reladock
# NOTIFICATION_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Node certificate issuer. Required whenever the production Agent listener is
# enabled so enrolled nodes can renew automatically. Use a dedicated online
# intermediate CA and keep the root signing key offline.
# Never point these at the local-development bundle.
NODE_BOOTSTRAP_CA_CERT=
NODE_BOOTSTRAP_CA_KEY=
NODE_BOOTSTRAP_CA_CHAIN=
# Optional one-command enrollment. These four release settings are required
# together, but may be omitted when only renewal of existing nodes is needed.
AGENT_PUBLIC_ORIGIN=
# Pin only artifacts actually uploaded to GitHub Releases, not latest.
NODE_RELEASE_VERSION=
NODE_RELEASE_AMD64_SHA256=
NODE_RELEASE_ARM64_SHA256=
