# Copy to /etc/reladock/control.env, chmod 0600. Fill values before starting.
APP_ENV=production
PUBLIC_ORIGIN=https://console.example.com:8443
LISTEN_ADDRESS=0.0.0.0:8443
DATABASE_URL=postgres://reladock:REPLACE_PASSWORD@127.0.0.1:5432/reladock?sslmode=disable
TLS_CERT_FILE=/etc/reladock/tls/fullchain.pem
TLS_KEY_FILE=/etc/reladock/tls/privkey.pem
# Independent Agent CA. Never place the CA signing key on this host.
AGENT_TLS_DIR=/etc/reladock/agent-server-pki
AGENT_LISTEN_ADDRESS=0.0.0.0:9443
# Optional Stripe connector. All four must be configured together; default disabled.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SUCCESS_URL=https://console.example.com:8443/
# STRIPE_CANCEL_URL=https://console.example.com:8443/
# Optional incident webhook. Both required together; default sends nothing.
# NOTIFICATION_WEBHOOK_URL=https://alerts.example.com/reladock
# NOTIFICATION_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
