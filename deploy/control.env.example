# Copy to /etc/reladock/control.env, chmod 0600. Fill values before starting.
APP_ENV=production
PUBLIC_ORIGIN=https://console.reladock.com
LISTEN_ADDRESS=0.0.0.0:8443
# Optional Prometheus endpoint. It is rejected unless bound to a distinct
# literal loopback address; expose it only through a local collector.
# METRICS_LISTEN_ADDRESS=127.0.0.1:9090
DATABASE_URL=postgres://reladock:REPLACE_PASSWORD@127.0.0.1:5432/reladock?sslmode=disable
# Optional Google OpenID Connect login. Leave both unset to disable. Configure
# the exact redirect URI ${PUBLIC_ORIGIN}/api/auth/google/callback in a Google
# Web application client; the secret stays server-side in this 0600 file.
# GOOGLE_OIDC_CLIENT_ID=REPLACE.apps.googleusercontent.com
# GOOGLE_OIDC_CLIENT_SECRET=REPLACE_SERVER_ONLY_SECRET
# Optional source-connection metadata retention. Leave unset to make every
# per-rule source logging enable request fail closed. Recommended after legal
# and contractual review: 180 (accepted range 30..365).
# SOURCE_FLOW_RETENTION_DAYS=180
# Optional generic AWS Lightsail script-node connector. It is independent from
# RelaDock relay nodes and is disabled unless all three settings are valid.
# Credentials are resolved by the AWS SDK default credential chain (for
# example, a least-privilege workload role); do not place AWS keys in this file.
# LIGHTSAIL_ENABLED=false
# Populate this explicit allowlist from a reviewed Lightsail GetRegions result.
# LIGHTSAIL_ALLOWED_REGIONS=ap-southeast-1,us-east-1
# LIGHTSAIL_SSH_SOURCE_CIDR=203.0.113.10/32
# Optional bounded Go durations; defaults are 5s, 15m, 30s, and 20m.
# LIGHTSAIL_WORKER_INTERVAL=5s
# LIGHTSAIL_AWS_OPERATION_TIMEOUT=15m
# LIGHTSAIL_SSH_CONNECT_TIMEOUT=30s
# LIGHTSAIL_SCRIPT_TIMEOUT=20m
# Emergency development/test-only switch. Exact value true bypasses plan,
# quota and expiry gates while preserving manual pause/delete and real metering.
# Keep false or unset in commercial production.
# RELADOCK_DEVELOPMENT_ALLOW_UNENTITLED_RULES=false
TLS_CERT_FILE=/etc/reladock/tls/fullchain.pem
TLS_KEY_FILE=/etc/reladock/tls/privkey.pem
# Agent listener trust bundle and server identity. This directory must not
# contain the node-issuing CA private key.
# Fresh installations generate and persist their Agent trust and signer automatically.
# Existing deployments: keep their AGENT_TLS_DIR/NODE_BOOTSTRAP_CA_* values
# and leave NODE_MANAGED_PKI_DIR unset. Never replace an existing trust root.
NODE_MANAGED_PKI_DIR=/var/lib/reladock/node-pki
# AGENT_TLS_DIR=/etc/reladock/agent-server-pki
AGENT_LISTEN_ADDRESS=0.0.0.0:9443
# Optional Stripe connector. All four must be configured together; default disabled.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SUCCESS_URL=https://console.example.com:8443/
# STRIPE_CANCEL_URL=https://console.example.com:8443/
# Optional receive-only TRON mainnet USDT connector. RPC URL and collection
# address are required together; API key is optional. No private key belongs in
# this service. Leave all unset to disable.
# TRON_USDT_RPC_URL=https://api.trongrid.io
# TRON_USDT_COLLECTION_ADDRESS=TU4x4apSvfu1NLx6ee11rM5PjtVCBbWssw
# TRON_API_KEY=
# Optional incident webhook. Both required together; default sends nothing.
# NOTIFICATION_WEBHOOK_URL=https://alerts.example.com/reladock
# NOTIFICATION_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Node certificate issuer. Required whenever the production Agent listener is
# enabled so enrolled nodes can renew automatically. Use a dedicated online
# intermediate CA and keep the root signing key offline.
# Never point these at the local-development bundle.
# NODE_BOOTSTRAP_CA_CERT=
# NODE_BOOTSTRAP_CA_KEY=
# NODE_BOOTSTRAP_CA_CHAIN=
# Optional one-command enrollment. These four release settings are required
# together, but may be omitted when only renewal of existing nodes is needed.
# Managed mode derives https://console.reladock.com:9443 automatically.
# AGENT_PUBLIC_ORIGIN=
# Pin only artifacts actually uploaded to GitHub Releases, not latest.
NODE_RELEASE_VERSION=
NODE_RELEASE_AMD64_SHA256=
NODE_RELEASE_ARM64_SHA256=
