RELADOCK_NODE=hk-01
RELADOCK_CONTROL=https://control.example.com:9443
RELADOCK_PKI=/etc/reladock/node-pki

# Default unit always remains validation-only. Application is a separate unit.
RELADOCK_STATE_DIR=/var/lib/reladock-agent
# Explicit values are required before any application can be considered.
RELADOCK_SNAT=
RELADOCK_SHAPING_INTERFACE=
RELADOCK_WAL_DIR=/var/lib/reladock-agent/wal
RELADOCK_NFT_BINARY=/usr/sbin/nft
RELADOCK_TC_BINARY=/usr/sbin/tc
RELADOCK_IP_BINARY=/usr/sbin/ip
RELADOCK_ETHTOOL_BINARY=/usr/sbin/ethtool
RELADOCK_SHAPING_LEASE=/etc/reladock/shaping.json
# Explicit reviewed apply unit requires an owned dedicated same-egress interface,
# ip_forward=1, disabled GRO/GSO/TSO/LRO and no flowtable/offload bypass.
# No installer changes these settings. Applied is not end-to-end health.
